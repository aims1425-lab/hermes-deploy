# Hermes Deploy - Environment Configuration
# Copy this to .env and fill in your values

# === Required ===
# Your main LLM provider API key (choose one)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
# OR use Nous Portal (no API key needed - run: hermes setup --portal)

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# === Discord Bot (optional) ===
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# === Optional ===
FAL_API_KEY=                     # Image generation
BROWSERBASE_API_KEY=              # Cloud browser automation
FIRECRAWL_API_KEY=                # Web search & extract
TAVILY_API_KEY=                   # Alternative web search
EXA_API_KEY=                      # Alternative web search

# === Security ===
HERMES_SECRET_KEY=                # Generate with: openssl rand -hex 32
ADMIN_EMAIL=                      # For Let's Encrypt / alerts

# === Deployment ===
HERMES_HOST=127.0.0.1
HERMES_PORT=8644
HERMES_PROFILE=default
LOG_LEVEL=info
